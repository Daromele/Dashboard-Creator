    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "express": "^5.2.1",
    "lucide-react": "^0.552.0",
