{
 "app": "../../site/index.html",
 "out": "shots",
 "setup": "(async()=>{const L=u=>new Promise((a,b)=>{const s=document.createElement('script');s.src=u;s.onload=a;s.onerror=b;document.head.appendChild(s);});await L('file:///home/user/Dashboard-Creator/recipe-library-studio/listing/deck/userdata.js');await L('file:///home/user/Dashboard-Creator/recipe-library-studio/listing/deck/stage.js');await window.__stage();await new Promise(r=>setTimeout(r,2500));})()",
 "content": "#content",
 "tabs": [
  {
   "name": "dashboard",
   "before": "go('dashboard')"
  },
  {
   "name": "import",
   "before": "lastLink='https://www.recipetineats.com/one-pot-chicken-risoni/';bulk.items=[];bulk.running=false;go('import')"
  },
  {
   "name": "bulk",
   "before": "go('import');lastLink='';bulk.items=[{url:'https://www.recipetineats.com/one-pot-chicken-risoni/',status:'saved',title:'One pot chicken risoni'},{url:'https://www.loveandlemons.com/banana-bread/',status:'saved',title:'Healthy banana bread'},{url:'https://www.bbcgoodfood.com/recipes/easy-pancakes',status:'saved',title:'Easy pancakes'},{url:'https://www.tasteofhome.com/recipes/best-lasagna/',status:'working'},{url:'https://www.kingarthurbaking.com/recipes/buttermilk-pancakes-recipe',status:'waiting'},{url:'https://www.allrecipes.com/recipe/12345/',status:'failed',msg:'This website blocks automatic access. Copy the page and use Paste the page text.'}];bulk.running=true;render();",
   "scrollTo": "section.card:has(#bulk-text)",
   "ratio": 1.6
  },
  {
   "name": "sites",
   "before": "bulk.items=[];bulk.running=false;go('import')",
   "scrollTo": "#sites"
  },
  {
   "name": "recipe",
   "before": "openRecipe(__pick(/garlic butter salmon/i))"
  },
  {
   "name": "scale",
   "before": "openRecipe(__pick(/kadai paneer|chole/i))",
   "scrollTo": ".recipe-cols"
  },
  {
   "name": "cook",
   "before": "openRecipe(__pick(/garlic butter salmon/i));setTimeout(()=>document.querySelector('[data-action=\"cook\"]').click(),50)"
  },
  {
   "name": "library",
   "before": "lib.view='grid';go('library')"
  },
  {
   "name": "collections",
   "before": "go('collections')"
  },
  {
   "name": "plan",
   "before": "go('plan')"
  },
  {
   "name": "shopping",
   "before": "go('shopping')"
  },
  {
   "name": "pantry",
   "before": "go('pantry')"
  },
  {
   "name": "log",
   "before": "openRecipe(state.recipes.find(r=>r.cooklog.length).id)",
   "scrollTo": "section.card:has(.cooklog)"
  },
  {
   "name": "insights",
   "before": "go('dashboard')",
   "scrollTo": "section.card:has(.kit-pie)"
  },
  {
   "name": "settings",
   "before": "go('settings')"
  }
 ],
 "themes": {
  "list": [
   "kiln",
   "ledger",
   "sage",
   "linen",
   "fjord",
   "slate",
   "night",
   "midnight"
  ],
  "apply": "state.settings.theme=T;go('dashboard');render();"
 }
}