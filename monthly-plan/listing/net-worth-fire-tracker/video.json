{
 "app": "../../app/NetWorthFireTracker.html",
 "setup": "try{localStorage.clear()}catch{};try{closeWelcome()}catch{};document.querySelector('[data-action=\"demo\"]').click();state.settings.hiddenNav=[];render();",
 "content": "#content",
 "navigate": "#nav button[data-go=\"{view}\"]",
 "brand": {
  "ink": "#10241F",
  "bold": "#16362F",
  "pop": "#E8B04B",
  "paper": "#F7F8F6",
  "calm": "#1F6F5C"
 },
 "fps": 30,
 "shots_dir": "vshots",
 "captures": [
  {
   "name": "dash",
   "view": "dashboard",
   "targets": {
    "hero": "#content .debt-hero",
    "heroL": "#content .debt-hero > div:first-child"
   }
  },
  {
   "name": "ci0",
   "view": "checkin",
   "scrollTo": "#content .nw-ci-sum",
   "targets": {
    "net": "#content .nw-ci-sum .kpi >> nth=0",
    "sum": "#content .nw-ci-sum",
    "a": "#content input[name=\"b-a-401k\"]",
    "b": "#content input[name=\"b-a-idx\"]",
    "rows": "#content #nw-ci-form"
   }
  },
  {
   "name": "ci1",
   "before": "const f=document.querySelector('#nw-ci-form'),set=(id,v)=>{const i=f.querySelector('[name=\"b-'+id+'\"]');i.value=v;i.dispatchEvent(new Event('input',{bubbles:true}));};set('a-401k','201450.00');",
   "clipFrom": "ci0"
  },
  {
   "name": "ci2",
   "before": "const f=document.querySelector('#nw-ci-form'),set=(id,v)=>{const i=f.querySelector('[name=\"b-'+id+'\"]');i.value=v;i.dispatchEvent(new Event('input',{bubbles:true}));};set('a-401k','201450.00');set('a-idx','133980.00');",
   "clipFrom": "ci0"
  },
  {
   "name": "fire",
   "view": "fire",
   "targets": {
    "hero": "#content .debt-hero",
    "heroL": "#content .debt-hero > div:first-child",
    "kpis": "#content .kpis"
   }
  },
  {
   "name": "road",
   "view": "fire",
   "before": "const r=document.querySelector('#content section:has(> .nw-chart)');document.querySelector('#content .kpis').after(r);window.scrollTo(0,r.getBoundingClientRect().top+scrollY-96);",
   "scrollTo": "#content section:has(> .nw-chart)",
   "targets": {
    "chart": "#content .nw-chart",
    "card": "#content section:has(> .nw-chart)"
   }
  },
  {
   "name": "miles",
   "view": "milestones",
   "targets": {
    "grid": "#content .nw-miles",
    "card": "#content .grid2.equal > :first-child"
   }
  },
  {
   "name": "accts",
   "view": "nwaccounts",
   "targets": {
    "c1": "#content .bt-card >> nth=0",
    "c2": "#content .bt-card >> nth=1",
    "c3": "#content .bt-card >> nth=2",
    "c4": "#content .bt-card >> nth=3"
   }
  }
 ],
 "product": "Net Worth & FIRE Tracker",
 "output": "Net_Worth_FIRE_Tracker_Etsy_Video.mp4",
 "size": [
  1440,
  1080
 ],
