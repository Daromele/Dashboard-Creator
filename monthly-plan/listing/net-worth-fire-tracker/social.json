    "hero": "#content .debt-hero",
    "heroL": "#content .debt-hero > div:first-child"
   }
  },
  {
   "name": "ci0",
   "view": "checkin",
   "scrollTo": "#content .nw-ci-sum",
   "targets": {
    "net": "#content .nw-ci-sum .kpi >> nth=0",
