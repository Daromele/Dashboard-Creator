{
 "app": "../../app/PaycheckBudgetPlanner.html",
 "setup": "try{localStorage.clear()}catch{};try{closeWelcome()}catch{};document.querySelector('[data-action=\"demo\"]').click();state.settings.hiddenNav=[];render();",
 "content": "#content",
 "navigate": "#nav button[data-go=\"{view}\"]",
 "brand": {
  "ink": "#2A2218",
  "bold": "#45392A",
  "pop": "#E8A24A",
  "paper": "#F7F4ED",
  "calm": "#6B5B45"
 },
 "fps": 30,
 "shots_dir": "vshots",
 "captures": [
  {
   "name": "dash",
   "view": "dashboard",
   "targets": {
    "hero": "#content .debt-hero",
    "heroL": "#content .debt-hero > div:first-child"
   }
  },
  {
   "name": "plan0",
   "view": "paychecks",
   "scrollTo": "#content section:has(> .bt-chart)",
   "targets": {
    "red": "#content .pp-bar.neg",
    "chart": "#content .bt-chart",
    "card": "#content section:has(> .bt-chart)"
   }
  },
  {
   "name": "plan1",
   "before": "const r=state.btBills.find(b=>b.id==='b-repair'),L=PaycheckUI.model().L;state.ppMoves={[r.id+'|'+r.start]:L[1].start};render();",
   "clipFrom": "plan0"
  },
  {
   "name": "chk0",
   "view": "dashboard",
   "before": "const e=document.querySelector('#content .grid2.equal');window.scrollTo(0,e.getBoundingClientRect().top+scrollY-96);",
   "scrollTo": "#content .grid2.equal",
   "targets": {
    "a": "#content .bt-check[data-id=\"b-care\"]",
    "b": "#content .bt-check[data-id=\"b-stream\"]",
    "list": "#content .bt-list",
    "env": "#content .grid2.equal > :last-child"
   }
  },
  {
   "name": "chk1",
   "click": [
    "#content .bt-check[data-id=\"b-care\"]"
   ],
   "clipFrom": "chk0"
  },
  {
   "name": "chk2",
   "click": [
    "#content .bt-check[data-id=\"b-stream\"]"
   ],
   "clipFrom": "chk0"
  },
  {
   "name": "spend",
   "view": "spending",
   "targets": {
    "kpis": "#content .kpis",
    "table": "#content .table-card"
   }
  },
  {
   "name": "sp0",
   "view": "dashboard",
   "before": "const e=document.querySelector('#content .sp-card');window.scrollTo(0,e.getBoundingClientRect().top+scrollY-150);",
   "scrollTo": "#content .sp-card",
   "targets": {
    "fun": "#content .sp-amt[data-k=\"env:e-fun\"]",
    "want": "#content .sp-bucket[data-b=\"want\"]",
    "buckets": "#content .sp-buckets",
    "banner": "#content [data-sp-banner]"
   }
  },
  {
   "name": "sp1",
   "before": "const i=document.querySelector('#content .sp-amt[data-k=\"env:e-fun\"]');i.value='800';i.dispatchEvent(new Event('input',{bubbles:true}));",
   "clipFrom": "sp0"
  }
 ],
 "product": "Paycheck Budget Planner",
 "output": "Paycheck_Budget_Planner_Etsy_Video.mp4",
 "size": [
  1440,
  1080
 ],
 "scenes": [
  {
   "type": "title",
   "dur": 2.0,
   "eyebrow": "Paycheck to paycheck budget",
   "headline": "Budget by<br>paycheck.",
   "pills": [
    "Bills by payday",
    "Spending money",
    "No subscription"
   ],
   "image": "dash"
  },
  {
   "type": "shot",
