{
 "app": "../../../bakeweek/Bakeweek_Studio.html",
 "date": "2026-10-20",
 "setup": "try{localStorage.clear()}catch{};try{closeTour()}catch{};toggleSample(true);go('settings');document.querySelector('[data-action=\"theme\"][data-k=\"kiln\"]').click();go('week');const T=document.querySelector('#toast');if(T)T.hidden=true;",
 "content": "#content",
 "navigate": "#nav [data-go=\"{view}\"]",
 "brand": {
  "ink": "#2A1A12",
  "bold": "#3A2419",
  "pop": "#F2B441",
  "paper": "#FBF8F5",
  "calm": "#A4471F"
 },
 "fps": 30,
 "shots_dir": "vshots",
 "captures": [
  {
   "name": "week",
   "view": "week",
   "targets": {
    "hero": "#content section.hero",
    "kpis": "#content .kpis"
   }
  },
  {
   "name": "doc0",
   "view": "docs",
   "targets": {
    "pay": "#content [data-action=\"doc-pay\"][data-id=\"sample-doc-1\"]",
    "kpis": "#content .kpis",
    "table": "#content section.table-card",
    "row": "#content tr:has([data-id=\"sample-doc-1\"])"
   }
  },
  {
   "name": "doc1",
   "click": [
    "#content [data-action=\"doc-pay\"][data-id=\"sample-doc-1\"]",
    "#docpay-form button[type=\"submit\"]"
   ],
   "clipFrom": "doc0"
  },
  {
   "name": "rec",
   "before": "go('recipes');document.querySelector('[data-action=\"recipe-view\"][data-k=\"table\"]').click();",
   "targets": {
    "table": "#content section.table-card"
   }
  },
  {
   "name": "shop",
   "before": "go('week');go('shopping');",
   "targets": {
    "kpis": "#content .kpis",
    "list": "#content section.table-card"
   }
  },
  {
   "name": "money",
   "before": "go('year');go('money');",
   "targets": {
    "hero": "#content section.hero",
    "kpis": "#content .kpis"
   }
  },
  {
   "name": "market",
   "view": "markets",
   "targets": {
    "hero": "#content section.hero",
    "kpis": "#content .kpis"
   }
  }
 ],
 "product": "Bakeweek Studio",
 "output": "Bakeweek_Studio_Etsy_Video.mp4",
 "size": [
  1440,
  1080
 ],
